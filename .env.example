# RagFlow 配置
RAGFLOW_URL=http://ragflow-cpu:9380
RAGFLOW_API_KEY=your-ragflow-api-key-here

# Flask 配置
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change-me-in-production-use-random-string

# 数据库配置
DATABASE_URL=sqlite:////app/data/knowledge.db

# 临时文件目录
TEMP_DIR=/tmp/ragflow_uploads

# 日志级别
LOG_LEVEL=INFO

# 端口映射（用于 docker-compose）
BACKEND_PORT=5000
FRONTEND_PORT=8080
